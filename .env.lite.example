# Lite profile env — copy to .env for the lite stack (docker-compose.lite.yml).
# Only OPENAI_API_KEY is strictly required.

ENVIRONMENT=prod

# LLM (OpenAI)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...

# Embeddings via OpenAI API (no local model / no torch)
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Reranker + PII off for the lite footprint
ENABLE_RERANKER=false
ENABLE_PII_REDACTION=false
ENABLE_INJECTION_DETECTION=true

# Qdrant — local container by default. For Qdrant Cloud, set the URL + API key:
# QDRANT_URL=https://xxxx.eu-central-1-0.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=...
QDRANT_URL=http://qdrant:6333
