# Application
ENVIRONMENT=dev
LOG_LEVEL=INFO

# LLM — set one of these depending on LLM_PROVIDER
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Embeddings
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=cpu

# Storage
QDRANT_URL=http://localhost:6333
POSTGRES_URL=postgresql+asyncpg://insightrag:insightrag@localhost:5432/insightrag
REDIS_URL=redis://localhost:6379/0

# Guardrails
ENABLE_PII_REDACTION=true
ENABLE_INJECTION_DETECTION=true
MAX_QUERY_LENGTH=1000

# Observability (optional)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
